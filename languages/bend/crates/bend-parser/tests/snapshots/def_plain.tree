(def
  add
  46..141 "def add(a: N…c{add(p, b)}"
  (doc 0..45 "# Adds two n… of the doc.")
  (params (a Nat) (b Nat))
  (ret Nat)
  (body (match (on a) (case (pats (ctr Zero)) b) (case (pats (ctr Succ p)) (ctr Succ (call add p b))))))
(def main 210..240 "def main() -… add(1n, 2n)" (params) (ret Nat) (body (call add (nat 1) (nat 2))))
